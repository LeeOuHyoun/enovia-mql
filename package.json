{
  "name": "enovia-mql",
  "displayName": "ENOVIA MQL",
  "description": "ENOVIA MQL 세션을 편집기 탭에서 사용합니다.",
  "version": "0.0.10",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "enovia-mql.show",
        "title": "ENOVIA MQL: 뷰 열기"
      },
      {
        "command": "enovia-mql.suggest",
        "title": "ENOVIA MQL: 명령 제안"
      },
      {
        "command": "enovia-mql.format",
        "title": "ENOVIA MQL: 포매팅"
      },
      {
        "command": "enovia-mql.joinLines",
        "title": "ENOVIA MQL: 줄 합치기"
      }
    ],
    "keybindings": [
      {
        "command": "enovia-mql.suggest",
        "key": "ctrl+space",
        "when": "activeWebviewPanelId == 'enovia-mql'"
      },
      {
        "command": "enovia-mql.format",
        "key": "ctrl+shift+f",
        "when": "activeWebviewPanelId == 'enovia-mql'"
      },
      {
        "command": "enovia-mql.joinLines",
        "key": "ctrl+j",
        "when": "activeWebviewPanelId == 'enovia-mql'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "enovia-mql.suggest",
          "when": "false"
        },
        {
          "command": "enovia-mql.format",
          "when": "false"
        },
        {
          "command": "enovia-mql.joinLines",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2"
  }
}
